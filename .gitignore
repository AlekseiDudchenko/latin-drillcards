# Node (no trailing slash: a symlinked node_modules in a worktree must be ignored too)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
packages/vocabulary-core/build-test/
public/v2/core/
public/v2/*.js
public/v2/catalog/

# Compiled client JS (generated by tsc from src/client — built by CI)
public/*.js
!public/sw.js
public/pages/*.js
public/pages/**/*.js
public/components/*.js
public/version.json
# Generated slug -> deck map for the level-less word links
public/data/word-index.json

# TS
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Playwright
playwright-report/
test-results/

/public/v2/storage/
/public/v2/families/**/*.js
# Generated v2 vocabulary seed (npm run build; identities are committed)
public/data/v2/

# Generated public v2 environment and self-hosted browser SDK
public/v2/environment.json
# Host redirects for the v2 site entry (scripts/build-site-entry.mjs, DRILLCARDS_SITE_ENTRY=v2)
public/_redirects
public/v2/vendor/
.env.v2.*
